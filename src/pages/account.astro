---
import Layout from '../components/Layout.astro';
// Static shell (prerendered, user-agnostic HTML). All user state is filled in
// client-side from /api/me so nothing user-specific is ever cached in the page.
---
<Layout title="Account">
  <main class="account">
    <h1>Account</h1>

    <div id="account-loading">Loading…</div>

    <section id="account-signed-out" hidden>
      <p>Sign in to save filters, tag outputs, group them into collections, and
        keep private notes — all private to you.</p>
      <a class="btn-github" href="/api/auth/login">
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        Sign in with GitHub
      </a>
    </section>

    <section id="account-signed-in" hidden>
      <div class="account-user">
        <img id="account-avatar" width="48" height="48" alt="" />
        <div>
          <div id="account-name" class="account-name"></div>
          <a id="account-login" class="account-login" target="_blank" rel="noopener"></a>
        </div>
      </div>
      <p class="account-hint">You're signed in. Saved filters, tags, collections,
        and notes will appear here and across the site as those features land.</p>
      <button id="account-logout" class="btn-secondary">Sign out</button>
    </section>
  </main>

  <script>
    const $ = (id) => document.getElementById(id);
    async function render() {
      let data = { user: null };
      try {
        const res = await fetch('/api/me', { headers: { 'x-requested-with': 'labindex' } });
        data = await res.json();
      } catch {}
      $('account-loading').hidden = true;
      if (data.user) {
        $('account-avatar').src = data.user.avatar_url || '';
        $('account-name').textContent = data.user.name || data.user.login;
        const login = $('account-login');
        login.textContent = '@' + data.user.login;
        login.href = 'https://github.com/' + data.user.login;
        $('account-signed-in').hidden = false;
      } else {
        $('account-signed-out').hidden = false;
      }
    }
    $('account-logout')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST', headers: { 'x-requested-with': 'labindex' } });
      location.reload();
    });
    render();
  </script>

  <style>
    .account { max-width: 640px; margin: 2rem auto; padding: 0 1rem; }
    .btn-github { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem;
      border-radius: 8px; background: #24292f; color: #fff; text-decoration: none; font-weight: 600; }
    .account-user { display: flex; align-items: center; gap: 0.75rem; margin: 1rem 0; }
    .account-user img { border-radius: 50%; }
    .account-name { font-weight: 600; }
    .account-login { color: var(--color-muted, #666); text-decoration: none; font-size: 0.9rem; }
    .account-hint { color: var(--color-muted, #666); font-size: 0.9rem; }
    .btn-secondary { padding: 0.4rem 0.9rem; border: 1px solid var(--color-border, #ddd);
      border-radius: 6px; background: transparent; cursor: pointer; }
  </style>
</Layout>
