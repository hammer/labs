---
import Layout from '../components/Layout.astro';
import TypeBadge from '../components/TypeBadge.astro';
import FilterBar from '../components/FilterBar.astro';
import SavedViews from '../components/SavedViews.astro';
import { getAllTimelineItems, getAllLabs, getLabBySlug, isGrouped, getOutputTypes, getModelFacets, getEvalFacets } from '../data/loader.js';
import type { NewsItem, ModelFacets } from '../data/loader.js';
import { formatValue } from '../lib/filters/format.js';
import type { FilterDimension, FormatToken } from '../lib/filters/types.js';

const items = getAllTimelineItems();
const outputCount = items.filter(i => i._kind === 'output').length;
const newsCount = items.filter(i => i._kind === 'news').length;
const labs = getAllLabs().map((l) => ({ slug: l.slug, name: l.name })).sort((a, b) => a.name.localeCompare(b.name));

const labCounts = new Map<string, number>();
const typeCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
const facetsByItem = new Map<unknown, ModelFacets | null>();
const evalFacetsByItem = new Map<unknown, { questions: number; tasks: number } | null>();

// Model-facet coverage, counted over rows whose types include 'model' —
// shown as hints in the scoped filter panels so sparse facets (a tokens
// filter reaches ~9% of model rows) are a visible tradeoff, not a surprise.
let modelRowCount = 0;
const facetCoverage = { arch: 0, params: 0, aparams: 0, tokens: 0, ctx: 0, intel: 0, openness: 0 };

items.forEach(item => {
  if (item._kind === 'output') {
    const labList = Array.isArray(item.lab) ? item.lab : [item.lab];
    labList.forEach(l => labCounts.set(l, (labCounts.get(l) || 0) + 1));
    const itemTypes = getOutputTypes(item);
    itemTypes.forEach(t => typeCounts.set(t, (typeCounts.get(t) || 0) + 1));
    (item.tags || []).forEach(t => tagCounts.set(t, (tagCounts.get(t) || 0) + 1));
    const facets = getModelFacets(item);
    facetsByItem.set(item, facets);
    evalFacetsByItem.set(item, getEvalFacets(item));
    if (itemTypes.includes('model')) {
      modelRowCount++;
      if (facets) {
        if (facets.arch) facetCoverage.arch++;
        if (facets.paramsB > 0) facetCoverage.params++;
        if (facets.aparamsB > 0) facetCoverage.aparams++;
        if (facets.tokensT > 0) facetCoverage.tokens++;
        if (facets.ctx > 0) facetCoverage.ctx++;
        if (facets.intel > 0) facetCoverage.intel++;
        if (facets.openness > 0) facetCoverage.openness++;
      }
    }
  } else {
    labCounts.set(item._labSlug, (labCounts.get(item._labSlug) || 0) + 1);
  }
});
typeCounts.set('news', newsCount);

const types = [...typeCounts.keys()].sort();
const tags = [...tagCounts.keys()].sort();

const archCounts = { dense: 0, moe: 0 };
for (const f of facetsByItem.values()) {
  if (f?.arch.includes('dense')) archCounts.dense++;
  if (f?.arch.includes('moe')) archCounts.moe++;
}

const hint = (n: number) => `Data: ${n} of ${modelRowCount} model rows`;
const modelScope = { dim: 'type', values: ['model'] };

const dimensions: FilterDimension[] = [
  {
    key: 'flagship',
    label: 'Flagship',
    kind: 'tristate',
    rowAttr: 'flagship',
    toggle: true,
  },
  {
    key: 'type',
    label: 'Type',
    kind: 'multi',
    rowAttr: 'type',
    options: types.map(t => ({ slug: t, label: t, count: typeCounts.get(t) ?? 0 })),
  },
  {
    key: 'lab',
    label: 'Lab',
    kind: 'multi',
    rowAttr: 'lab',
    options: labs.map(l => ({ slug: l.slug, label: l.name, count: labCounts.get(l.slug) ?? 0 })),
  },
  {
    key: 'tag',
    label: 'Tag',
    kind: 'multi',
    rowAttr: 'tags',
    options: tags.map(t => ({ slug: t, label: t, count: tagCounts.get(t) ?? 0 })),
  },
  // Model-scoped dimensions — visible only while Type is narrowed to model.
  // Containment semantics: a row matches if the release contains a model
  // with the value (union/max across grouped sub-outputs and variants).
  {
    key: 'arch', label: 'Architecture', kind: 'multi', rowAttr: 'arch',
    visibleWhen: modelScope, hint: hint(facetCoverage.arch),
    options: [
      { slug: 'dense', label: 'Dense', count: archCounts.dense },
      { slug: 'moe', label: 'MoE (sparse)', count: archCounts.moe },
    ],
  },
  {
    key: 'params', label: 'Parameters', kind: 'range', rowAttr: 'params',
    unit: 'B params', format: 'paramsB', excludeMissing: true,
    visibleWhen: modelScope, hint: hint(facetCoverage.params),
  },
  {
    key: 'aparams', label: 'Active params', kind: 'range', rowAttr: 'aparams',
    unit: 'B params', format: 'paramsB', excludeMissing: true,
    visibleWhen: modelScope, hint: hint(facetCoverage.aparams),
  },
  {
    key: 'tokens', label: 'Training tokens', kind: 'range', rowAttr: 'tokens',
    unit: 'T tokens', format: 'tokensT', excludeMissing: true,
    visibleWhen: modelScope, hint: hint(facetCoverage.tokens),
  },
  {
    key: 'ctx', label: 'Context window', kind: 'range', rowAttr: 'ctx',
    unit: 'tokens', format: 'compact', excludeMissing: true,
    visibleWhen: modelScope, hint: hint(facetCoverage.ctx),
  },
  {
    key: 'intel', label: 'Intelligence', kind: 'range', rowAttr: 'intel',
    excludeMissing: true, visibleWhen: modelScope,
    hint: `${hint(facetCoverage.intel)} (AA v4-verified scores only)`,
  },
  {
    key: 'openness', label: 'Openness', kind: 'range', rowAttr: 'openness',
    format: 'score100', excludeMissing: true,
    visibleWhen: modelScope, hint: hint(facetCoverage.openness),
  },
];

// ─── Type-driven column sets ──────────────────────────────────────────
// The metric columns shown swap with the output type the Type filter is
// narrowed to — only columns that make sense for the type. All columns are
// server-rendered (cells filled, headers sortable); the page script toggles
// the active set via table[data-colset] and CSS.

interface MetricColumn {
  key: string;          // row.dataset key + sort key + col-<key> class
  label: string;        // header text — short: width budgets are measured and tight
  format: FormatToken;
  title: string;
}

const COLUMNS: MetricColumn[] = [
  { key: 'stars', label: 'Stars', format: 'compact', title: 'GitHub stars — max across all repos referenced in the output' },
  { key: 'downloads', label: 'Downloads', format: 'compact', title: 'HuggingFace downloads — summed across all unique models in the output' },
  { key: 'citations', label: 'Citations', format: 'compact', title: 'OpenAlex citations — summed across all unique papers in the output' },
  { key: 'params', label: 'Params', format: 'paramsB', title: 'Total parameters — file-wide max across variants and estimates; ~ marks third-party estimates, (max) marks the largest family variant' },
  { key: 'aparams', label: 'Active', format: 'paramsB', title: 'Active parameters per token (MoE); (max) marks the largest family variant' },
  { key: 'tokens', label: 'Tokens', format: 'tokensT', title: 'Training tokens' },
  { key: 'ctx', label: 'Context', format: 'compact', title: 'Context window in tokens' },
  { key: 'intel', label: 'Intel', format: 'plain', title: 'Artificial Analysis Intelligence Index — AA v4-verified scores only' },
  { key: 'openness', label: 'Open', format: 'score100', title: 'Artificial Analysis Openness Index' },
  { key: 'questions', label: 'Questions', format: 'compact', title: 'Benchmark questions/examples in the scored eval set' },
  { key: 'tasks', label: 'Tasks', format: 'plain', title: 'Benchmark tasks/subtasks (the paper’s own decomposition)' },
];

const COLSETS: Record<string, string[]> = {
  general: ['stars', 'downloads', 'citations'],
  model: ['params', 'aparams', 'tokens', 'ctx', 'intel', 'openness'],
  paper: ['citations', 'stars'],
  eval: ['questions', 'tasks', 'citations'],
  library: ['stars', 'citations'],
  dataset: ['downloads', 'stars', 'citations'],
  blog: ['stars'],
  announcement: [],
  news: [],
};

const colsetConfig = JSON.stringify({
  columns: COLUMNS.map(c => ({ key: c.key, label: c.label })),
  colsets: COLSETS,
});

// Generated colset stylesheet — enumerated per-column selectors from the
// same COLSETS/COLUMNS source as the markup, injected inline after the
// table so it cascades after the scoped <style>. The show → narrow-hide →
// active-sort-re-show chains share specificity and resolve by source order.
const showSelectors = Object.entries(COLSETS)
  .flatMap(([set, cols]) => cols.map(k => `.timeline-table[data-colset="${set}"] .col-${k}`))
  .join(',\n');
const sortShow768 = COLUMNS
  .map(c => `  .timeline-table[data-active-sort="${c.key}"] .col-${c.key}`)
  .join(',\n');
const sortShow600 = COLUMNS
  .map(c => `  .timeline-table[data-active-sort="${c.key}"] .tl-row td.col-${c.key}`)
  .join(',\n');
const colsetCss = `
${showSelectors} {
  display: table-cell;
}
/* 769-900px: the 6-column model set's min-content is a measured 884px —
   trim the secondary columns in this band, keeping the actively-sorted one
   (banded so it can't fight the <=768px tier's specificity). */
@media (min-width: 769px) and (max-width: 900px) {
  .timeline-table[data-colset="model"] .col-tokens,
  .timeline-table[data-colset="model"] .col-ctx,
  .timeline-table[data-colset="model"] .col-openness {
    display: none;
  }
  .timeline-table[data-colset="model"][data-active-sort="tokens"] .col-tokens,
  .timeline-table[data-colset="model"][data-active-sort="ctx"] .col-ctx,
  .timeline-table[data-colset="model"][data-active-sort="openness"] .col-openness {
    display: table-cell;
  }
}
/* <=768px: hide all metric columns except the one being sorted by, so the
   list never visibly reorders on data the user can't see. */
@media (max-width: 768px) {
  .timeline-table[data-colset] .col-m {
    display: none;
  }
${sortShow768} {
    display: table-cell;
  }
}
/* <=600px stacked rows: only the active-sort value joins the meta line. */
@media (max-width: 600px) {
  .timeline-table[data-colset] .tl-row td.col-m {
    display: none;
  }
${sortShow600} {
    display: inline;
    font-size: 0.75rem;
  }
}`;

/** Formatted cell text for one metric column of one output row. */
function cellText(
  key: string,
  format: FormatToken,
  m: { github_stars?: number; hf_downloads?: number; citations?: number } | undefined,
  f: ModelFacets | null | undefined,
  ev: { questions: number; tasks: number } | null | undefined,
): string {
  const v: number | undefined = {
    stars: m?.github_stars,
    downloads: m?.hf_downloads,
    citations: m?.citations,
    params: f?.paramsB,
    aparams: f?.aparamsB,
    tokens: f?.tokensT,
    ctx: f?.ctx,
    intel: f?.intel,
    openness: f?.openness,
    questions: ev?.questions,
    tasks: ev?.tasks,
  }[key];
  if (!v) return '';
  let text = formatValue(format, v);
  // Provenance markers keep the anchoring convention honest: a displayed
  // number that matches no top-level field is self-explaining.
  const src = key === 'params' ? f?.paramsSrc : key === 'aparams' ? f?.aparamsSrc : '';
  if (src === 'estimate') text = `~${text}`;
  else if (src === 'variant') text = `${text} (max)`;
  return text;
}
---

<Layout title="Timeline">
  <header class="page-header">
    <h1>Timeline</h1>
    <p class="subtitle">{outputCount} outputs, {newsCount} news<span class="kbd-only"> &middot; <button class="shortcut-hint" id="shortcut-hint">Keyboard shortcuts <kbd>?</kbd></button></span></p>
  </header>

  <div class="view-bar">
    <div class="view-toggle" id="view-toggle">
      <button class="view-btn active" data-view="all">All</button>
      <button class="view-btn" data-view="outputs">Outputs</button>
      <button class="view-btn" data-view="news">News</button>
    </div>
    <button
      class="flagship-toggle"
      id="flagship-toggle"
      type="button"
      aria-pressed="false"
      title="Flagship filter — click cycles: all → flagship only → non-flagship"
    >
      <span class="flagship-toggle-star" aria-hidden="true">&#9733;</span>
      <span class="flagship-toggle-label">Flagship</span>
    </button>
    <label class="sort-control" id="sort-control">
      <span class="sort-control-label">Sort</span>
      <select id="sort-select" aria-label="Sort by">
        <option value="date">Date</option>
        <option value="stars">Stars</option>
        <option value="downloads">Downloads</option>
        <option value="citations">Citations</option>
      </select>
    </label>
  </div>

  <FilterBar mode="palette" dimensions={dimensions} hotkey="f" id="filter-bar" />
  <SavedViews page="timeline" basePath="/timeline" />

  <table class="timeline-table" id="timeline-table" data-colset="general">
    <thead>
      <tr>
        <th class="col-date sortable" data-sort="date">Date <span class="sort-arrow active-desc">&#9662;</span></th>
        <th class="col-name">Name</th>
        <th class="col-lab">Lab</th>
        <th class="col-type">Type</th>
        {COLUMNS.map(c => (
          <th class={`col-m col-${c.key} sortable`} data-sort={c.key} title={c.title}>{c.label} <span class="sort-arrow"></span></th>
        ))}
      </tr>
    </thead>
    <tbody>
      {items.map((item, i) => {
        if (item._kind === 'news') {
          const news = item as NewsItem;
          return (
            <tr
              class="tl-row tl-news"
              data-href={news.url}
              data-external="1"
              data-lab={news._labSlug}
              data-type="news"
              data-tags=""
              data-flagship="0"
              data-date={news.date}
              data-stars=""
              data-downloads=""
              data-citations=""
              data-kind="news"
              data-index={i}
            >
              <td class="col-date">{news.date}</td>
              <td class="col-name">
                <a href={news.url} class="news-link" target="_blank" rel="noopener">{news.title}</a>
                {news.source && <span class="news-source">{news.source}</span>}
              </td>
              <td class="col-lab"><a href={`/labs/${news._labSlug}`} class="lab-link">{news.labName}</a></td>
              <td class="col-type"><TypeBadge type="news" /></td>
              {COLUMNS.map(c => <td class={`col-m col-${c.key}`}></td>)}
            </tr>
          );
        }

        const labList = Array.isArray(item.lab) ? item.lab : [item.lab];
        const labEntries = labList.map(s => ({ slug: s, name: getLabBySlug(s)?.name ?? s }));
        const outputTypes = getOutputTypes(item);
        const grouped = isGrouped(item);
        const m = item._metrics;
        const f = facetsByItem.get(item);
        const ev = evalFacetsByItem.get(item);
        return (
          <tr
            class="tl-row"
            data-href={`/outputs/${item._labSlug}/${item.slug}`}
            data-lab={labList.join(',')}
            data-type={outputTypes.join(',')}
            data-tags={(item.tags || []).join(',')}
            data-flagship={item.flagship ? '1' : '0'}
            data-date={item.date}
            data-stars={m?.github_stars ?? ''}
            data-downloads={m?.hf_downloads ?? ''}
            data-citations={m?.citations ?? ''}
            data-arch={f?.arch || undefined}
            data-params={f && f.paramsB > 0 ? f.paramsB : undefined}
            data-params-src={f?.paramsSrc || undefined}
            data-aparams={f && f.aparamsB > 0 ? f.aparamsB : undefined}
            data-aparams-src={f?.aparamsSrc || undefined}
            data-tokens={f && f.tokensT > 0 ? f.tokensT : undefined}
            data-ctx={f && f.ctx > 0 ? f.ctx : undefined}
            data-intel={f && f.intel > 0 ? f.intel : undefined}
            data-openness={f && f.openness > 0 ? f.openness : undefined}
            data-questions={ev && ev.questions > 0 ? ev.questions : undefined}
            data-tasks={ev && ev.tasks > 0 ? ev.tasks : undefined}
            data-kind="output"
            data-index={i}
          >
            <td class="col-date">{item.date}</td>
            <td class="col-name">
              {item.flagship && <span class="flagship-star" title="Flagship release">&#9733;</span>}
              {item.name}
              {grouped && <span class="group-badge">{item.outputs.length}</span>}
            </td>
            <td class="col-lab">{labEntries.map((l, j) => <>{j > 0 && ', '}<a href={`/labs/${l.slug}`} class="lab-link">{l.name}</a></>)}</td>
            <td class="col-type">
              {outputTypes.map(t => <TypeBadge type={t} />)}
            </td>
            {COLUMNS.map(c => <td class={`col-m col-${c.key}`}>{cellText(c.key, c.format, m, f, ev)}</td>)}
          </tr>
        );
      })}
    </tbody>
  </table>

  <script id="colset-config" type="application/json" set:html={colsetConfig}></script>
  <style is:inline set:html={colsetCss}></style>

  <button class="back-to-top hidden" id="back-to-top" aria-label="Back to top">&uarr;</button>

  <div class="shortcut-modal hidden" id="shortcut-modal">
    <div class="shortcut-backdrop" id="shortcut-backdrop"></div>
    <div class="shortcut-dialog">
      <h3>Keyboard shortcuts</h3>
      <div class="shortcut-grid">
        <div class="shortcut-group">
          <h4>Navigation</h4>
          <dl>
            <div><dt><kbd>j</kbd></dt><dd>Move down</dd></div>
            <div><dt><kbd>k</kbd></dt><dd>Move up</dd></div>
            <div><dt><kbd>o</kbd> / <kbd>Enter</kbd></dt><dd>Open item</dd></div>
            <div><dt><kbd>g</kbd> then <kbd>g</kbd></dt><dd>Go to top</dd></div>
            <div><dt><kbd>G</kbd></dt><dd>Go to bottom</dd></div>
            <div><dt><kbd>g</kbd> then <kbd>h</kbd></dt><dd>Go home</dd></div>
            <div><dt><kbd>g</kbd> then <kbd>t</kbd></dt><dd>Go to timeline</dd></div>
          </dl>
        </div>
        <div class="shortcut-group">
          <h4>Other</h4>
          <dl>
            <div><dt><kbd>/</kbd></dt><dd>Search</dd></div>
            <div><dt><kbd>f</kbd></dt><dd>Open filters</dd></div>
            <div><dt><kbd>v</kbd></dt><dd>Cycle view</dd></div>
            <div><dt><kbd>s</kbd></dt><dd>Cycle sort</dd></div>
            <div><dt><kbd>Esc</kbd></dt><dd>Clear / close</dd></div>
            <div><dt><kbd>?</kbd></dt><dd>Show this help</dd></div>
          </dl>
        </div>
      </div>
      <button class="close-btn" id="close-shortcuts">&times;</button>
    </div>
  </div>
</Layout>

<script>
  import type { FilterChangeDetail } from '../lib/filters/types';
  import { rowMatches } from '../lib/filters/state';
  import { installMyTagFilter, hrefToTarget } from '../lib/mytags-filter';
  import type { FilterDimension } from '../lib/filters/types';

  const tbody = document.querySelector<HTMLTableSectionElement>('#timeline-table tbody')!;
  const allRows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.tl-row'));
  const modal = document.getElementById('shortcut-modal')!;
  const backdrop = document.getElementById('shortcut-backdrop')!;
  const closeBtn = document.getElementById('close-shortcuts')!;
  const hintBtn = document.getElementById('shortcut-hint')!;
  const sortHeaders = document.querySelectorAll<HTMLTableCellElement>('.sortable');
  const viewBtns = document.querySelectorAll<HTMLButtonElement>('.view-btn');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const table = document.getElementById('timeline-table')!;
  const backToTop = document.getElementById('back-to-top')!;
  const filterBarEl = document.getElementById('filter-bar')!;
  const filterCountEl = filterBarEl.querySelector<HTMLElement>('.filter-count')!;

  // Read dim config from the script tag the FilterBar component injected.
  const dimensions: FilterDimension[] = JSON.parse(
    document.getElementById('filter-bar-config')!.textContent!,
  ).dimensions;

  let selected = -1;
  let visibleRows: HTMLTableRowElement[] = [...allRows];
  let waitingForG = false;
  let gTimer: ReturnType<typeof setTimeout> | null = null;
  let currentView: 'all' | 'outputs' | 'news' = 'all';
  let lastFilterState: Parameters<typeof rowMatches>[1] = {};
  let myTagFilter: import('../lib/mytags-filter').MyTagFilter | null = null;

  // Sort state
  type SortColumn = 'date' | 'stars' | 'downloads' | 'citations'
    | 'params' | 'aparams' | 'tokens' | 'ctx' | 'intel' | 'openness'
    | 'questions' | 'tasks';
  let currentSort: SortColumn = 'date';
  let sortDesc = true;

  // ─── Type-driven column sets ─────────────────────────────────────────
  // The visible metric columns follow the Type filter: narrowed to one
  // type → that type's column set; otherwise the general set. Headers are
  // the sort affordance (the select is the ≤768px touch alternative).
  const colsetCfg: {
    columns: Array<{ key: string; label: string }>;
    colsets: Record<string, string[]>;
  } = JSON.parse(document.getElementById('colset-config')!.textContent!);
  const COL_LABELS = new Map(colsetCfg.columns.map(c => [c.key, c.label]));
  const COLSETS = colsetCfg.colsets;
  const validSortKeys: SortColumn[] = ['date', ...colsetCfg.columns.map(c => c.key as SortColumn)];

  let currentColset = 'general';

  function computeColset(state: FilterChangeDetail['state']): string {
    const t = state['type'];
    if (t && t.kind === 'multi' && t.values.size === 1) {
      const v = [...t.values][0]!;
      if (COLSETS[v]) return v;
    }
    return 'general';
  }

  function rebuildSortSelect() {
    const keys: SortColumn[] = ['date', ...(COLSETS[currentColset] ?? []) as SortColumn[]];
    sortSelect.innerHTML = keys
      .map(k => `<option value="${k}">${k === 'date' ? 'Date' : COL_LABELS.get(k) ?? k}</option>`)
      .join('');
    sortSelect.value = keys.includes(currentSort) ? currentSort : 'date';
  }

  function applyColset(set: string) {
    const changed = set !== currentColset;
    currentColset = set;
    table.dataset.colset = set;
    if (changed) rebuildSortSelect();
    // Sorts follow the same scope as columns and filters: a sort whose
    // column isn't in the active set reverts to date (no sorting on data
    // the user can't see).
    if (currentSort !== 'date' && !(COLSETS[set] ?? []).includes(currentSort)) {
      sortRows('date', true);
    }
  }

  // ─── View toggle ─────────────────────────────────────────────────────

  viewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentView = btn.dataset.view as typeof currentView;
      viewBtns.forEach(b => b.classList.toggle('active', b === btn));
      updateVisibility();
      syncViewToURL();
    });
  });

  function cycleView() {
    const views: typeof currentView[] = ['all', 'outputs', 'news'];
    const idx = views.indexOf(currentView);
    const next = views[(idx + 1) % views.length];
    const btn = document.querySelector<HTMLButtonElement>(`.view-btn[data-view="${next}"]`);
    if (btn) btn.click();
  }

  // ─── Filter integration ──────────────────────────────────────────────

  function onFilterState(state: FilterChangeDetail['state']) {
    lastFilterState = state;
    applyColset(computeColset(state));
    updateVisibility();
    reflectFlagshipToggle(state);
  }

  // ─── View-bar ★ Flagship quick toggle ────────────────────────────────
  // One click from anywhere: cycles any → flagship-only → non-flagship via
  // the FilterBar API, so the palette, chips, and URL stay the one source
  // of truth. The button only mirrors state.
  const flagshipToggle = document.getElementById('flagship-toggle');
  function reflectFlagshipToggle(state: FilterChangeDetail['state']) {
    if (!flagshipToggle) return;
    const v = (state.flagship as { value?: string } | undefined)?.value ?? 'any';
    flagshipToggle.classList.toggle('active', v === 'yes');
    flagshipToggle.classList.toggle('exclude', v === 'no');
    flagshipToggle.setAttribute('aria-pressed', String(v !== 'any'));
    flagshipToggle.title = v === 'any'
      ? 'Flagship filter — click cycles: all → flagship only → non-flagship'
      : v === 'yes' ? 'Showing flagship releases only — click for non-flagship'
      : 'Hiding flagship releases — click to show all';
  }
  flagshipToggle?.addEventListener('click', () => {
    (filterBarEl as any).__filterBarApi?.cycleTristate('flagship');
  });

  filterBarEl.addEventListener('filters:changed', (e) => {
    onFilterState((e as CustomEvent<FilterChangeDetail>).detail.state);
  });
  // Pull the initial state if the FilterBar initialized before this script
  // evaluated (module fetch order can put us past its deferred dispatch).
  {
    const api = (filterBarEl as any).__filterBarApi;
    if (api) onFilterState(api.getState());
  }

  // "My tags" filter (issue #21). Best-effort + additive: no-op when logged out
  // or when no tag is selected (getState() → null makes updateVisibility identical).
  installMyTagFilter({
    dimensions, rows: allRows as unknown as HTMLElement[], filterBarEl,
    onChange: updateVisibility,
    rowTarget: (r) => hrefToTarget((r as HTMLElement).dataset.href),
  }).then((f) => { myTagFilter = f; if (f) updateVisibility(); }).catch(() => {});

  // ─── Sort ────────────────────────────────────────────────────────────

  function getNumericAttr(row: HTMLTableRowElement, attr: string): number {
    const v = row.dataset[attr];
    return v ? Number(v) : -1;
  }

  function sortRows(column: SortColumn, desc: boolean) {
    currentSort = column;
    sortDesc = desc;

    allRows.sort((a, b) => {
      let va: number | string, vb: number | string;
      if (column === 'date') {
        va = a.dataset.date!;
        vb = b.dataset.date!;
        return desc ? vb.localeCompare(va as string) : (va as string).localeCompare(vb as string);
      } else {
        va = getNumericAttr(a, column);
        vb = getNumericAttr(b, column);
        if (va === -1 && vb === -1) return 0;
        if (va === -1) return 1;
        if (vb === -1) return -1;
        return desc ? (vb as number) - (va as number) : (va as number) - (vb as number);
      }
    });

    for (const row of allRows) {
      tbody.appendChild(row);
    }

    sortHeaders.forEach(th => {
      const arrow = th.querySelector('.sort-arrow')!;
      const col = th.dataset.sort;
      arrow.className = 'sort-arrow';
      if (col === column) {
        arrow.classList.add(desc ? 'active-desc' : 'active-asc');
        arrow.innerHTML = desc ? '&#9662;' : '&#9652;';
      } else {
        arrow.textContent = '';
      }
    });

    // Single sync point for the sort select and the stacked-row metric /
    // attribute display: header clicks, the 's' shortcut, URL restore, and
    // the select itself all funnel through here.
    sortSelect.value = column;
    if (column === 'date') delete table.dataset.activeSort;
    else table.dataset.activeSort = column;

    updateVisibility();
    syncViewToURL();
  }

  sortSelect.addEventListener('change', () => {
    const v = sortSelect.value as SortColumn;
    if (validSortKeys.includes(v)) sortRows(v, true);
  });

  sortHeaders.forEach(th => {
    th.addEventListener('click', () => {
      const col = th.dataset.sort as SortColumn;
      if (!col) return; // attribute column header while showing a non-sortable attr
      if (col === currentSort) {
        sortRows(col, !sortDesc);
      } else {
        sortRows(col, true);
      }
    });
  });

  function cycleSortShortcut() {
    // Cycle date + the active column set's sorts — exactly what's visible.
    const cycle: SortColumn[] = ['date', ...(COLSETS[currentColset] ?? []) as SortColumn[]];
    const idx = cycle.indexOf(currentSort);
    const next = cycle[(idx + 1) % cycle.length]!;
    sortRows(next, true);
  }

  // ─── Visibility ──────────────────────────────────────────────────────

  function updateVisibility() {
    const ms = myTagFilter?.getState();
    const fs = ms ? { ...lastFilterState, mytag: ms } : lastFilterState;
    allRows.forEach(row => {
      const kind = row.dataset.kind;
      // View filter
      if (currentView === 'outputs' && kind !== 'output') { row.style.display = 'none'; return; }
      if (currentView === 'news' && kind !== 'news') { row.style.display = 'none'; return; }

      // FilterBar state
      const ok = rowMatches(row.dataset as Record<string, string | undefined>, fs, dimensions);
      row.style.display = ok ? '' : 'none';
    });

    visibleRows = allRows.filter(r => r.style.display !== 'none');
    let countText = visibleRows.length < allRows.length
      ? `${visibleRows.length} of ${allRows.length}`
      : '';
    // Sparse-sort feedback: say how many visible rows actually carry the
    // sorted attribute (the rest keep stable order at the bottom).
    if (currentSort !== 'date') {
      const ranked = visibleRows.filter(r => r.dataset[currentSort]).length;
      const note = `${ranked} ranked by ${(COL_LABELS.get(currentSort) ?? currentSort).toLowerCase()}`;
      countText = countText ? `${countText} · ${note}` : note;
    }
    filterCountEl.textContent = countText;

    if (selected >= visibleRows.length) {
      select(visibleRows.length - 1);
    }
  }

  // ─── Selection ───────────────────────────────────────────────────────

  function select(index: number) {
    if (visibleRows.length === 0) return;
    const clamped = Math.max(0, Math.min(index, visibleRows.length - 1));
    allRows.forEach(r => r.classList.remove('selected'));
    selected = clamped;
    visibleRows[selected]!.classList.add('selected');
    visibleRows[selected]!.scrollIntoView({ block: 'nearest' });
  }

  function openSelected() {
    if (selected >= 0 && selected < visibleRows.length) {
      const row = visibleRows[selected]!;
      const href = row.dataset.href;
      if (!href) return;
      if (row.dataset.external === '1') {
        window.open(href, '_blank', 'noopener');
      } else {
        window.location.href = href;
      }
    }
  }

  function toggleModal(show?: boolean) {
    const isShown = !modal.classList.contains('hidden');
    modal.classList.toggle('hidden', show !== undefined ? !show : isShown);
  }

  // Click to navigate
  allRows.forEach(row => {
    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.lab-link')) return;
      if ((e.target as HTMLElement).closest('.news-link')) return;
      const href = row.dataset.href;
      if (!href) return;
      if (row.dataset.external === '1') {
        window.open(href, '_blank', 'noopener');
      } else {
        window.location.href = href;
      }
    });
  });

  // ─── URL sync (view + sort only — filters owned by FilterBar) ────────

  function syncViewToURL() {
    const params = new URLSearchParams(window.location.search);
    if (currentView !== 'all') params.set('view', currentView);
    else params.delete('view');
    if (currentSort !== 'date') params.set('sort', currentSort);
    else params.delete('sort');
    if (!sortDesc) params.set('asc', '1');
    else params.delete('asc');
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
  }

  function restoreFromURL() {
    const params = new URLSearchParams(window.location.search);
    const view = params.get('view');
    if (view === 'outputs' || view === 'news') {
      currentView = view;
      viewBtns.forEach(b => b.classList.toggle('active', b.dataset.view === view));
    }
    const sort = params.get('sort') as SortColumn | null;
    if (sort && validSortKeys.includes(sort)) {
      // Validate against the colset the URL itself implies, not the runtime
      // colset — the FilterBar handshake makes arrival order of the filter
      // state nondeterministic, and an out-of-set sort must not stick
      // (sorted by an invisible column, blank select). ?type=model&sort=params
      // restores; bare ?sort=params (an old-format link) falls back to date.
      const typeParam = (params.get('type') ?? '').split(',').filter(Boolean);
      const implied = typeParam.length === 1 && COLSETS[typeParam[0]!] ? typeParam[0]! : 'general';
      if (sort === 'date' || (COLSETS[implied] ?? []).includes(sort)) {
        sortRows(sort, params.get('asc') !== '1');
      }
    }
  }

  restoreFromURL();

  // ─── Keyboard shortcuts ──────────────────────────────────────────────

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.target instanceof HTMLSelectElement) return;
    if ((window as any).isSearchOpen) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;

    // FilterBar handles its own keys when its panel is open; let it run.
    const target = e.target as HTMLElement | null;
    if (target?.closest('.dim-panel') || target?.closest('.palette-panel')) return;

    switch (e.key) {
      case 'j':
        e.preventDefault();
        select(selected + 1);
        break;
      case 'k':
        e.preventDefault();
        select(selected - 1);
        break;
      case 'o':
      case 'Enter':
        e.preventDefault();
        openSelected();
        break;
      case 'g':
        if (waitingForG) {
          e.preventDefault();
          select(0);
          waitingForG = false;
          if (gTimer) clearTimeout(gTimer);
        } else {
          waitingForG = true;
          gTimer = setTimeout(() => { waitingForG = false; }, 500);
        }
        break;
      case 'G':
        e.preventDefault();
        select(visibleRows.length - 1);
        break;
      case 'v':
        e.preventDefault();
        cycleView();
        break;
      case 's':
        e.preventDefault();
        cycleSortShortcut();
        break;
      case '?':
        e.preventDefault();
        toggleModal();
        break;
      case 'Escape':
        if (!modal.classList.contains('hidden')) {
          e.preventDefault();
          toggleModal(false);
        } else {
          // FilterBar's own panel-close is handled by its keyboard handler;
          // here we only clear row selection.
          allRows.forEach(r => r.classList.remove('selected'));
          selected = -1;
        }
        break;
    }
  });

  backdrop.addEventListener('click', () => toggleModal(false));
  closeBtn.addEventListener('click', () => toggleModal(false));
  hintBtn.addEventListener('click', () => toggleModal(true));

  // ─── Back to top (touch alternative to g g on a very long page) ──────

  let btopVisible = false;
  window.addEventListener('scroll', () => {
    const show = window.scrollY > window.innerHeight * 2;
    if (show !== btopVisible) {
      btopVisible = show;
      backToTop.classList.toggle('hidden', !show);
    }
  }, { passive: true });
  backToTop.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

