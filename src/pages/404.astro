---
// Static 404 page. Without a dist/404.html, Cloudflare Pages falls back to
// serving index.html with HTTP 200 for every unknown path (SPA fallback) —
// so deleted outputs kept their URLs alive as soft-200 copies of the home
// page (discovered 2026-08-05 via the deduplicated apertus-v1.5 URL).
// Astro emits this file as dist/404.html, which Pages serves with a real
// 404 status for any path not in the deployment.
import Layout from '../components/Layout.astro';
---

<Layout title="Not found">
  <div class="container nf">
    <h1>404 — not found</h1>
    <p>
      This page doesn't exist — it may have been renamed, merged into
      another entry, or removed.
    </p>
    <p>
      Try the <a href="/">lab index</a>, the
      <a href="/timeline">timeline</a>, or search with
      <kbd>/</kbd>.
    </p>
  </div>
</Layout>

<style>
  .nf {
    padding: 4rem 1rem;
    max-width: 40rem;
  }
  .nf h1 {
    margin-bottom: 1rem;
  }
  .nf p {
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
