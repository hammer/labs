---
import Layout from '../components/Layout.astro';
// Static shell; the collection list + items are user data rendered client-side.
---
<Layout title="Collections">
  <main class="collections">
    <h1>Collections</h1>
    <div id="coll-loading">Loading…</div>
    <p id="coll-signedout" hidden>Please <a href="/account">sign in</a> to create collections.</p>
    <div id="coll-app" hidden>
      <form id="coll-create">
        <input id="coll-create-name" type="text" placeholder="New collection name…" maxlength="120" />
        <button type="submit">Create</button>
      </form>
      <div class="coll-layout">
        <ul id="coll-list" class="coll-list"></ul>
        <section id="coll-detail" class="coll-detail" hidden>
          <h2 id="coll-detail-name"></h2>
          <button id="coll-delete" class="coll-del" type="button">Delete collection</button>
          <ul id="coll-items" class="coll-items"></ul>
        </section>
      </div>
    </div>
  </main>

  <script>
    const H = { 'x-requested-with': 'labindex' };
    const $ = (id) => document.getElementById(id);
    let selected = null;
    function url(t) { if (t.startsWith('output:')) return '/outputs/' + t.slice(7); if (t.startsWith('lab:')) return '/labs/' + t.slice(4); return '#'; }
    function label(t) { return (t.split('/').pop() || t).replace(/^(output:|lab:)/, ''); }

    async function loadList() {
      let res;
      try { res = await fetch('/api/me/collections', { headers: H }); } catch { $('coll-loading').textContent = 'Failed to load.'; return; }
      $('coll-loading').hidden = true;
      if (res.status !== 200) { $('coll-signedout').hidden = false; return; }
      $('coll-app').hidden = false;
      const { collections } = await res.json();
      const list = $('coll-list'); list.innerHTML = '';
      if (!collections.length) { const li = document.createElement('li'); li.className = 'coll-empty'; li.textContent = 'No collections yet — create one above.'; list.appendChild(li); }
      for (const c of collections) {
        const li = document.createElement('li');
        const a = document.createElement('button'); a.type = 'button'; a.className = 'coll-name';
        a.textContent = `${c.name} (${c.n})`;
        a.addEventListener('click', () => openCollection(c));
        li.appendChild(a); list.appendChild(li);
      }
    }

    async function openCollection(c) {
      selected = c;
      $('coll-detail').hidden = false;
      $('coll-detail-name').textContent = c.name;
      const res = await fetch(`/api/me/collection-items?collection_id=${c.id}`, { headers: H });
      const items = res.ok ? (await res.json()).items : [];
      const ul = $('coll-items'); ul.innerHTML = '';
      if (!items.length) { const li = document.createElement('li'); li.textContent = 'Empty — add items from any output or lab page.'; ul.appendChild(li); }
      for (const t of items) {
        const li = document.createElement('li');
        const a = document.createElement('a'); a.href = url(t); a.textContent = label(t);
        const rm = document.createElement('button'); rm.type = 'button'; rm.className = 'coll-rm'; rm.textContent = '×';
        rm.addEventListener('click', async () => { await fetch(`/api/me/collection-items?collection_id=${c.id}&target=${encodeURIComponent(t)}`, { method: 'DELETE', headers: H }); openCollection(c); loadList(); });
        li.append(a, rm); ul.appendChild(li);
      }
    }

    $('coll-create').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $('coll-create-name').value.trim(); if (!name) return;
      await fetch('/api/me/collections', { method: 'POST', headers: { ...H, 'content-type': 'application/json' }, body: JSON.stringify({ name }) });
      $('coll-create-name').value = ''; loadList();
    });
    $('coll-delete').addEventListener('click', async () => {
      if (!selected || !confirm(`Delete collection "${selected.name}"?`)) return;
      await fetch(`/api/me/collections?id=${selected.id}`, { method: 'DELETE', headers: H });
      $('coll-detail').hidden = true; selected = null; loadList();
    });
    loadList();
  </script>

  <style>
    .collections { max-width: 800px; margin: 2rem auto; padding: 0 1rem; }
    #coll-create { display: flex; gap: 0.4rem; margin: 1rem 0; }
    #coll-create input { flex: 1; border: 1px solid var(--border, #ddd); border-radius: 6px; padding: 0.4rem 0.6rem; }
    #coll-create button, #coll-delete { border: 1px solid var(--border, #ddd); border-radius: 6px; background: transparent; cursor: pointer; padding: 0.4rem 0.8rem; }
    .coll-layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: 1.5rem; }
    .coll-list, .coll-items { list-style: none; margin: 0; padding: 0; }
    .coll-name { background: transparent; border: none; cursor: pointer; text-align: left; padding: 0.3rem 0; color: var(--color-accent, #0645ad); font-size: 0.95rem; }
    .coll-items li { display: flex; align-items: center; justify-content: space-between; padding: 0.25rem 0; }
    .coll-rm { border: none; background: transparent; cursor: pointer; color: var(--text-muted, #999); }
    .coll-detail { border-left: 1px solid var(--border, #eee); padding-left: 1.5rem; }
    .coll-del { margin-bottom: 0.6rem; }
    .coll-empty { color: var(--text-muted, #888); }
    @media (max-width: 600px) { .coll-layout { grid-template-columns: 1fr; } .coll-detail { border-left: none; padding-left: 0; } }
  </style>
</Layout>
